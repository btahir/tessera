---
import { REPO_URL, SPONSOR_URL } from '../config'
import { THEMES, capitalize, countWord, plateRange } from '../lib/themes'
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <p class="name">Tessera</p>
      <p class="line">{plateRange()}. {capitalize(countWord(THEMES.length))} {THEMES.length === 1 ? 'theme' : 'themes'} for the Claude Code desktop app, made to read in.</p>
    </div>
    <ul class="links">
      <li><a href={SPONSOR_URL} rel="noopener">Sponsored by ShipTiffin</a></li>
      <li><a href={REPO_URL} rel="noopener">Source on GitHub</a></li>
      <li><a href={`${REPO_URL}/blob/main/LICENSE`} rel="license noopener">MIT License</a></li>
    </ul>
    <p class="fine">An independent project. Not affiliated with Anthropic.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 56px 48px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .top {
    display: grid;
    gap: 6px;
    margin-bottom: 28px;
  }

  .name {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .fine {
    color: var(--ink-3);
    font-size: 14px;
  }
</style>
